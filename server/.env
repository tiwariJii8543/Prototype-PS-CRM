#############################################
# PS-CRM server environment configuration
# Replace placeholders with secure values before running
#############################################

# Database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ps_crm_db

# Application
JWT_SECRET=replace-with-a-secure-random-string
PORT=5000

# Email Configuration (for notifications)
# Set ENABLE_EMAIL_NOTIFICATIONS=true to enable OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=

APP_URL=http://localhost:5000

# Ethereal (disposable test SMTP) support
# Set USE_ETHEREAL=true to auto-create a disposable test account and send emails there.
USE_ETHEREAL=false

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true

# Notes:
# - Do NOT commit real secrets to source control. Keep this file local and secure.
# - For Gmail use an App Password or configure SMTP relay; set SMTP_SECURE=true for port 465.